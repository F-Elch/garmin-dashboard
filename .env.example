# Kopiere diese Datei nach .env und trage deine Garmin-Connect-Zugangsdaten ein.
# .env steht in .gitignore und verlässt nie deinen PC.
# Nach dem ersten erfolgreichen Login liegen Tokens in .garmin_tokens/ –
# das Passwort wird danach nur noch gebraucht, wenn die Tokens ablaufen.
GARMIN_EMAIL=deine.adresse@example.com
GARMIN_PASSWORD=dein-passwort

# Optional: Wohin die fertige HTML zusätzlich kopiert wird (Standard: OneDrive\Privat\Garmin).
# Leer lassen (DASHBOARD_COPY_TO=) schaltet die Kopie ab.
# DASHBOARD_COPY_TO=%USERPROFILE%\OneDrive\Privat\Garmin
